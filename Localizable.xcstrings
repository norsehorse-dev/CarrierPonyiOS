            "value" : "Keine Relays festgelegt. Die Nostr-Zustellung bleibt aus, bis du mindestens eines hinzufügst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay relés configurados. El envío por Nostr permanece desactivado hasta que añadas al menos uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun relais défini. La distribution via Nostr reste désactivée tant que vous n'en ajoutez pas au moins un."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun relay impostato. La consegna via Nostr resta disattivata finché non ne aggiungi almeno uno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
