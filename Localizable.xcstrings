    },
    "This channel's admin is on an older CarrierPony. Ask them to update to version 4.0 or later, then subscribe again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Admin dieses Kanals nutzt eine ältere Version von CarrierPony. Bitte ihn, auf Version 4.0 oder neuer zu aktualisieren, und abonniere den Kanal dann erneut."
