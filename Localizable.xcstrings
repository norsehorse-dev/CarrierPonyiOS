    "%lld waiting from someone whose pairing hasn't finished on this device. They open on their own once it does." : {
      "comment" : "Banner on the conversation list when inbox messages cannot be opened yet because the sender's pairing has not finished. The argument is the count.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Nachricht(en) warten von jemandem, dessen Koppeln auf diesem Gerät noch nicht abgeschlossen ist. Sie öffnen sich von selbst, sobald es fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mensaje(s) en espera de alguien cuyo emparejamiento no ha terminado en este dispositivo. Se abrirán solos cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld message(s) en attente de quelqu'un dont l'appairage n'est pas terminé sur cet appareil. Ils s'ouvriront tout seuls une fois terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld messaggio/i in attesa da qualcuno il cui abbinamento non è completo su questo dispositivo. Si apriranno da soli quando lo sarà."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この端末でペアリングが完了していない相手から %lld 件のメッセージが待機中です。完了すると自動的に開きます。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld mensagem(ns) aguardando de alguém cujo pareamento não terminou neste dispositivo. Elas abrem sozinhas quando terminar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидает сообщений: %lld от того, чьё сопряжение на этом устройстве ещё не завершено. Они откроются сами, когда оно завершится."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有 %lld 条消息来自尚未在此设备上完成配对的人。配对完成后会自动打开。"
          }
        }
      }
    },
