    "%@ hasn't finished pairing yet. Your messages will open on their side once their app checks in." : {
      "comment" : "Banner in a conversation after accepting the contact's invite, until their side of the pairing confirms. The argument is the contact's name.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat das Koppeln noch nicht abgeschlossen. Deine Nachrichten werden dort geöffnet, sobald die App sich meldet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aún no ha terminado el emparejamiento. Tus mensajes se abrirán en su lado cuando su app se conecte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ n'a pas encore terminé l'appairage. Vos messages s'ouvriront de son côté dès que son app se connectera."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non ha ancora completato l'abbinamento. I tuoi messaggi si apriranno dalla sua parte quando la sua app si collega."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のペアリングはまだ完了していません。相手のアプリが接続すると、メッセージが開けるようになります。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ainda não concluiu o pareamento. Suas mensagens vão abrir do lado dele quando o app se conectar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ещё не завершил сопряжение. Ваши сообщения откроются у него, когда его приложение выйдет на связь."
          }
        },
        "zh" : {
