        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти люди добавили вас по вашему открытому ключу. Приняв запрос, вы добавите человека как непроверенный контакт."
          }
        },
        "zh" : {
          "stringUnit" : {
