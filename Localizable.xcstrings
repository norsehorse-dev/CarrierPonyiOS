            "value" : "Private Nachrichten und Dateiübertragung.\nEnde-zu-Ende verschlüsselt, signiert und Ihres."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mensajería y transferencia de archivos privadas.\nCifradas de extremo a extremo, firmadas y tuyas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
