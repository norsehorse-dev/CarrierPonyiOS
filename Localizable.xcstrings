    "Importing replaces your current identity on this device. Back it up first if you still need it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Import ersetzt Ihre aktuelle Identität auf diesem Gerät. Sichern Sie sie zuerst, falls Sie sie noch brauchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importar reemplaza tu identidad actual en este dispositivo. Haz un respaldo antes si aún la necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'import remplace votre identité actuelle sur cet appareil. Sauvegardez-la d'abord si vous en avez encore besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'importazione sostituisce la tua identità attuale su questo dispositivo. Fai prima un backup se ti serve ancora."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートするとこの端末の現在のIDが置き換わります。まだ必要なら先にバックアップしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
