    "Compare this number with %@ over a call or in person. If it matches on both devices, no one is intercepting your messages." : {
      "comment" : "A description below the label that explains what the safety number is and how to use it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergleiche diese Nummer mit %@ per Anruf oder persönlich. Wenn sie auf beiden Geräten übereinstimmt, fängt niemand deine Nachrichten ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compara este número con %@ por llamada o en persona. Si coincide en ambos dispositivos, nadie está interceptando tus mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparez ce numéro avec %@ par appel ou en personne. S'il correspond sur les deux appareils, personne n'intercepte vos messages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confronta questo numero con %@ tramite chiamata o di persona. Se corrisponde su entrambi i dispositivi, nessuno sta intercettando i tuoi messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この番号を通話または対面で %@ と照合してください。両方の端末で一致すれば、誰もメッセージを傍受していません。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare este número com %@ por chamada ou pessoalmente. Se coincidir nos dois dispositivos, ninguém está interceptando suas mensagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сравните это число с %@ по звонку или лично. Если оно совпадает на обоих устройствах, никто не перехватывает ваши сообщения."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过通话或当面与 %@ 核对此数字。如果两台设备上一致，就没有人在拦截您的消息。"
          }
        }
      }
    },
