    "Messages are end-to-end encrypted and signed. Say hello." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten sind Ende-zu-Ende verschlüsselt und signiert. Sagen Sie Hallo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mensajes están cifrados de extremo a extremo y firmados. Saluda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages sont chiffrés de bout en bout et signés. Dites bonjour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I messaggi sono crittografati end-to-end e firmati. Saluta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メッセージはエンドツーエンドで暗号化・署名されています。あいさつしましょう。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As mensagens são criptografadas de ponta a ponta e assinadas. Diga olá."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сообщения зашифрованы сквозным шифрованием и подписаны. Поздоровайтесь."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "消息经端到端加密并签名。打个招呼吧。"
          }
        }
      }
    },
