    "Erases your identity, contacts, conversations, files, and all settings. This cannot be undone. Back up first if you want to keep your identity." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht Identität, Kontakte, Unterhaltungen, Dateien und alle Einstellungen. Nicht rückgängig zu machen. Sichern Sie zuerst, wenn Sie Ihre Identität behalten möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Borra tu identidad, contactos, conversaciones, archivos y todos los ajustes. No se puede deshacer. Haz un respaldo antes si quieres conservar tu identidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efface votre identité, vos contacts, conversations, fichiers et tous les réglages. Irréversible. Sauvegardez d'abord si vous voulez garder votre identité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancella identità, contatti, conversazioni, file e tutte le impostazioni. Irreversibile. Fai un backup prima se vuoi conservare la tua identità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ID・連絡先・会話・ファイル・すべての設定を消去します。元に戻せません。IDを残すには先にバックアップしてください。"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga sua identidade, contatos, conversas, arquivos e todas as configurações. Não pode ser desfeito. Faça backup antes se quiser manter sua identidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стирает личность, контакты, переписки, файлы и все настройки. Отменить нельзя. Сделайте резервную копию, если хотите сохранить личность."
          }
        },
        "zh" : {
          "stringUnit" : {
            "state" : "translated",
